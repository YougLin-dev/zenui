# Check every text file out with LF on every platform.
#
# crates/app/tests/golden_trace.rs compares the generated trace with
# crates/app/tests/golden/todolist_headless.trace through `include_str!` and
# byte-for-byte string comparison. A CRLF checkout on Windows would change
# the compared text without any source change.
* text=auto eol=lf
*.trace text eol=lf
